run = "npm run dev"
modules = ["nodejs-20:v8-20231227-322e88b"]

[nix]
channel = "stable-24_05"

[env]
PORT = "5000"

[deployment]
deploymentTarget = "cloudrun"
run = ["sh", "-c", "npm run build && npm run start"]
build = ["sh", "-c", "npm install"]

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 5173
externalPort = 3000
