{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true
  },
  "include": ["vite.config.ts", "tailwind.config.ts", "server/**/*.ts", "db/**/*.ts", "drizzle.config.ts"]
}
